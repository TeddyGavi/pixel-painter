	(gr_text "J1 AWHW-34 shroud 50.8 x 8.9 (bottom side) - wider than the PCB, as assumed by case-revB"
		(at 118.25 65.2 0)
		(layer "Dwgs.User")
		(uuid "f9acf321-396f-589b-98ae-fdb9623c4233")
		(effects
			(font
				(size 0.7 0.7)
				(thickness 0.1)
			)
		)
	)
	(gr_text "Control PCB Rev B variant J (THB001P thumbstick). Front view = KiCad top view, Y_front = -Y_kicad.\nTOP (faces the panel): cursor control, ENC1, SW1 MENU, SW2 SIDE, TP1/TP2. BOTTOM: J1 header, all R/C.\nTracks 0.3 signal / 0.5 3V3+GND, clearance 0.2, GND zones F.Cu+B.Cu (press B to fill). All nets routed by tracks.\nHoles (case-revB): H1 (-4,-20), H2 (40,-44.5), H3 (18.25,-25). Keep-outs: top dia 6.2 all; bottom dia 6.6 H1/H2, dia 4.4 H3.\nSW2 SIDE actuator tip X 43.20 (case max 43.20), actuator centre Y -23.0; courtyard edge X 42.85.\nSW1 MENU = B3F-1000 6 mm at (18.25,-18.10): a B3F-4055 12 mm body cannot fit between J1 (bottom pins) and the H3 boss.\nJS1 THB001P footprint is PROVISIONAL (hole positions not verified) - redraw from the C&K drawing before ordering."
		(at 146 69 0)
		(layer "Cmts.User")
		(uuid "d9ceaa34-8c8d-5390-a6f5-a9a5f347f18b")
		(effects
			(font
				(size 1 1)
				(thickness 0.15)
			)
			(justify left top)
		)
	)
