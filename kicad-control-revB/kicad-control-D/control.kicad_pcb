	(gr_text "FFC CONTACTS TO BOARD"
		(at 134 75 0)
		(layer "B.SilkS")
		(uuid "6a092e60-2510-4134-8404-14320e21d2a9")
		(effects
			(font
				(size 0.8 0.8)
				(thickness 0.15)
			)
			(justify mirror)
		)
	)
	(gr_text "J1 FH12-16S-0.5SH (bottom): 30 mm same-side FFC to the J8 adapter PCB"
		(at 118.25 65.2 0)
		(layer "Dwgs.User")
		(uuid "5c0f29c1-711b-59a4-9a13-e92f73988f87")
		(effects
			(font
				(size 0.7 0.7)
				(thickness 0.1)
			)
		)
	)
	(gr_text "Control PCB Rev B variant D (SKQUCAA010 5-way). Front view = KiCad top view, Y_front = -Y_kicad.\nTOP (faces the panel): cursor control, ENC1, SW1 MENU, SW2 SIDE, TP1/TP2. BOTTOM: J1 FPC connector (FH12-16S, JLC-assembled), all R/C.\nTracks 0.3 signal / 0.5 3V3+GND, clearance 0.2, GND zones F.Cu+B.Cu (press B to fill). All nets routed by tracks.\nHoles (case-revB): H1 (-4,-20), H2 (40,-44.5), H3 (18.25,-25). Keep-outs: top dia 6.2 all; bottom dia 6.6 H1/H2, dia 4.4 H3.\nSW2 SIDE actuator tip X 43.20 (case max 43.20), actuator centre Y -23.0; courtyard edge X 42.85.\nSW1 MENU = B3F-1000 6 mm at (18.25,-18.10): a B3F-4055 12 mm body cannot fit between the old J1 header and the H3 boss.\nSW3 SKQUCAA010: middle-pin offset and A..D direction map TBV (1:1 print test).\nRev B5 (2026-11-19): J1 AWHW 2x17 + R13/R14 removed; J1 = Hirose FH12-16S-0.5SH(55) 0.5 mm FPC, slot at the top edge. USB sense moved to the J8 adapter PCB."
		(at 146 69 0)
		(layer "Cmts.User")
		(uuid "0ea317bf-76f8-5303-a54c-697c73561c9f")
		(effects
			(font
				(size 1 1)
				(thickness 0.15)
			)
			(justify left top)
		)
	)
