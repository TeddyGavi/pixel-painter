	(text "J1 = 2x17 shrouded header on the BOTTOM side of the control PCB.\nPin n = Waveshare J8 pin n through a 34-way IDC ribbon\n(H3DDH-3406G class, both ends female, pin 1 to pin 1).\nUnused J8 pins are left open (no-connect flags).\nPull-ups go to 3V3 only (never BAT or USB_5V)."
		(exclude_from_sim no)
		(at 22.86 152.4 0)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "57d40ceb-ce6f-5f6a-ac21-d12135080791")
	)
